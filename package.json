    "proof:pages": "node scripts/pages-proof.mjs",
    "test": "node --test test/*.test.js test/*.test.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "jpeg-js": "^0.4.4",
    "playwright-core": "^1.65.0",
    "pngjs": "^7.0.0"
  }
